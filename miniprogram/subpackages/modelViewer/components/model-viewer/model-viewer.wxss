.model-viewer {
  position: relative;
  width: 100%;
  height: 100%;
  background: #1a1a2e;
  overflow: hidden;
}

.gl-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.model-title {
  position: absolute;
  top: 24rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.9);
  font-size: 30rpx;
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
  z-index: 10;
  pointer-events: none;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 20;
  background: rgba(26, 26, 46, 0.75);
}

.overlay-text {
  color: rgba(255, 255, 255, 0.85);
  font-size: 28rpx;
}

.overlay-error {
  color: #ff6b6b;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
  padding: 0 48rpx;
}

.retry-btn {
  margin-top: 32rpx;
  padding: 16rpx 64rpx;
  background: #4ecdc4;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.debug-panel {
  position: absolute;
  top: 80rpx;
  left: 24rpx;
  padding: 16rpx 24rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 12rpx;
  z-index: 15;
}

.debug-line {
  display: block;
  color: #7ef0d8;
  font-size: 22rpx;
  line-height: 1.6;
}

.controls {
  position: absolute;
  bottom: 48rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 15;
}

.ctrl-btn {
  padding: 18rpx 30rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  color: rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  font-size: 26rpx;
  text-align: center;
}
