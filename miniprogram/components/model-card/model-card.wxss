.card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.15s;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.card:active {
  transform: scale(0.97);
}

.card-thumb-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  background: #f5f5f5;
}

.card-thumb {
  width: 100%;
  height: 100%;
}

.card-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 4rpx 12rpx;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.favorite-btn {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  transition: transform 0.2s;
}

.favorite-btn:active {
  transform: scale(1.1);
}

.favorite-icon {
  font-size: 28rpx;
}

.card-body {
  padding: 16rpx 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-price {
  font-size: 26rpx;
  font-weight: 600;
  color: #e74c3c;
  flex-shrink: 0;
}

.card-desc {
  font-size: 24rpx;
  color: #666666;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
  margin-bottom: 12rpx;
  min-height: 72rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.card-merchant {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.merchant-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e8e8e8;
}

.merchant-name {
  font-size: 22rpx;
  color: #888888;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-category {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(78, 205, 196, 0.15);
  border: 1rpx solid rgba(78, 205, 196, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-text {
  font-size: 20rpx;
  color: #4ecdc4;
}
