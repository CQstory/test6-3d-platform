page { background: #f5f5f5; }
.page { min-height: 100vh; }
.page-content { padding-bottom: 60rpx; }

/* 说明卡片 */
.intro-card {
  background: linear-gradient(135deg, #1a1a2e, #302b63);
  margin: 20rpx 24rpx 24rpx;
  padding: 40rpx 32rpx;
  border-radius: 20rpx;
}
.intro-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.intro-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}
.intro-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}

/* 表单 */
.form-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  padding: 24rpx 48rpx 16rpx;
}
.form-group {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-item:last-child { border-bottom: none; }
.form-label {
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
  width: 160rpx;
}
.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}
.form-item-col {
  flex-direction: column;
  align-items: flex-start;
}
.form-item-col .form-label {
  width: auto;
  margin-bottom: 16rpx;
}
.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  height: 140rpx;
}
.form-picker { flex: 1; text-align: right; font-size: 28rpx; color: #333; }

/* 提交 */
.save-area { padding: 40rpx 24rpx; }
.btn-save {
  width: 100%;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 28rpx;
}
.btn-save[disabled] {
  background: #a8dcd6;
  color: #fff;
}

.bottom-spacer { height: 40rpx; }
