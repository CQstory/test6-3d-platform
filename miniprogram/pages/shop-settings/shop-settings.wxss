page { background: #f5f5f5; }
.page { min-height: 100vh; }
.page-content { padding-bottom: 60rpx; }

/* 封面图 */
.cover-section {
  position: relative;
  margin: 20rpx 24rpx 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #e8e8e8;
}
.cover-preview {
  width: 100%;
  height: 280rpx;
}
.cover-placeholder {
  height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cover-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.cover-tip { font-size: 26rpx; color: #999; }
.cover-edit {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 头像 */
.avatar-row {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}
.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eee;
}
.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}
.avatar-edit {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 0 0 60rpx 60rpx;
  padding: 4rpx 0 8rpx;
}
.avatar-info {
  margin-left: 24rpx;
}
.avatar-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}
.avatar-sub {
  font-size: 24rpx;
  color: #999;
}

/* 表单 */
.form-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  padding: 24rpx 48rpx 16rpx;
}
.form-group {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-item:last-child { border-bottom: none; }
.form-label {
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
  width: 160rpx;
}
.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}
.form-item-col {
  flex-direction: column;
  align-items: flex-start;
}
.form-item-col .form-label {
  width: auto;
  margin-bottom: 16rpx;
}
.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  height: 140rpx;
}

/* 保存按钮 */
.save-area { padding: 40rpx 24rpx; }
.btn-save {
  width: 100%;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 28rpx;
}
.btn-save[disabled] {
  background: #a8dcd6;
  color: #fff;
}

.bottom-spacer { height: 40rpx; }
