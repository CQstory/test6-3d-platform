<view class="page">
  <top-bar title="店铺设置" showBack="{{true}}" />
  <view class="page-content">
    <!-- 封面图 -->
    <view class="cover-section" bindtap="onChooseCover">
      <image class="cover-preview" src="{{coverPath || cover}}" mode="aspectFill" wx:if="{{coverPath || cover}}" />
      <view class="cover-placeholder" wx:else>
        <text class="cover-icon">🖼</text>
        <text class="cover-tip">点击设置店铺封面</text>
      </view>
      <view class="cover-edit" wx:if="{{coverPath || cover}}">更换封面</view>
    </view>

    <!-- 头像 -->
    <view class="avatar-row">
      <view class="avatar-wrap" bindtap="onChooseAvatar">
        <image class="avatar-preview" src="{{avatarPath || avatar}}" mode="aspectFill" wx:if="{{avatarPath || avatar}}" />
        <view class="avatar-placeholder" wx:else>📷</view>
        <view class="avatar-edit">更换头像</view>
      </view>
      <view class="avatar-info">
        <text class="avatar-label">店铺头像</text>
        <text class="avatar-sub">点击更换头像</text>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="form-group">
      <view class="form-item">
        <text class="form-label">店铺名称 *</text>
        <input class="form-input" value="{{name}}" bindinput="onInput" data-field="name" placeholder="店铺名称" />
      </view>
      <view class="form-item form-item-col">
        <text class="form-label">店铺简介</text>
        <textarea class="form-textarea" value="{{description}}" bindinput="onInput" data-field="description" placeholder="介绍你的店铺与作品风格..." maxlength="200" />
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="form-group-title">联系方式</view>
    <view class="form-group">
      <view class="form-item">
        <text class="form-label">微信</text>
        <input class="form-input" value="{{wechat}}" bindinput="onInput" data-field="wechat" placeholder="微信号" />
      </view>
      <view class="form-item">
        <text class="form-label">电话</text>
        <input class="form-input" type="number" value="{{phone}}" bindinput="onInput" data-field="phone" placeholder="联系电话" />
      </view>
      <view class="form-item">
        <text class="form-label">邮箱</text>
        <input class="form-input" value="{{email}}" bindinput="onInput" data-field="email" placeholder="联系邮箱" />
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="save-area">
      <button class="btn-save" bindtap="onSave" loading="{{uploading}}" disabled="{{uploading || loading}}">
        {{uploading ? '保存中...' : '保存'}}
      </button>
    </view>

    <view class="bottom-spacer"></view>
  </view>
</view>
