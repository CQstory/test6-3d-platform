page { background: #f5f5f5; }
.page { min-height: 100vh; }
.page-content { padding-left: 24rpx; padding-right: 24rpx; padding-bottom: 40rpx; }
.plan-card {
  position: relative; margin-bottom: 24rpx; padding: 32rpx;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.plan-card.highlight {
  border: 2rpx solid #4ecdc4;
  box-shadow: 0 4rpx 20rpx rgba(78,205,196,0.2);
}
.plan-name { font-size: 30rpx; font-weight: 600; color: #1a1a1a; display: block; }
.plan-price { margin: 16rpx 0; }
.price-num { font-size: 48rpx; font-weight: 700; color: #4ecdc4; }
.price-unit { font-size: 26rpx; color: #999; }
.plan-slots { font-size: 24rpx; color: #666; display: block; margin-bottom: 16rpx; }
.plan-features { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.feature-item { display: flex; align-items: center; padding: 8rpx 0; font-size: 26rpx; color: #333; }
.feature-check { color: #4ecdc4; font-weight: 600; margin-right: 12rpx; }
.plan-badge {
  position: absolute; top: 0; right: 0;
  padding: 8rpx 24rpx;
  background: #4ecdc4; color: #fff;
  font-size: 22rpx; font-weight: 500;
  border-radius: 0 16rpx 0 12rpx;
}
