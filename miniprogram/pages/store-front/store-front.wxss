page { background: #f5f5f5; }
.page { min-height: 100vh; }
.page-content { padding-bottom: 40rpx; }
.store-cover { width: 100%; height: 360rpx; }
.store-info {
  margin: -40rpx 24rpx 0;
  padding: 32rpx 24rpx;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
}
.store-avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  border: 4rpx solid #fff; margin-top: -70rpx;
  background: #e8e8e8;
}
.store-name { font-size: 32rpx; font-weight: 600; color: #1a1a1a; display: block; margin-top: 16rpx; }
.store-desc { font-size: 26rpx; color: #666; line-height: 1.6; display: block; margin-top: 12rpx; }
.store-stats { display: flex; justify-content: space-around; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #f0f0f0; }
.stat-item { text-align: center; }
.stat-num { font-size: 32rpx; font-weight: 600; color: #4ecdc4; display: block; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }
