.page {
  min-height: 100vh;
  background: #f5f5f5;
}
.page-content {
  padding-bottom: 120rpx;
}

/* 占位 */
.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.placeholder-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.placeholder-text { font-size: 30rpx; color: #333; margin-bottom: 12rpx; }
.placeholder-sub { font-size: 24rpx; color: #999; }

/* 店铺信息卡 */
.shop-card {
  position: relative;
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}
.shop-cover {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
}
.shop-card-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(26, 26, 46, 0.72), rgba(26, 26, 46, 0.35));
}
.shop-card-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 40rpx 28rpx;
}
.shop-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  background: #fff;
  flex-shrink: 0;
}
.shop-card-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.shop-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}
.shop-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-manage {
  flex-shrink: 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
}

/* 内部 Tab */
.inner-tabs {
  display: flex;
  background: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.inner-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}
.inner-tab.active {
  color: #1a1a2e;
  font-weight: 600;
  border-bottom-color: #1a1a2e;
}

/* Tab 内容 */
.tab-content {
  padding: 0 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }

/* 店铺信息卡：图片加载前留背景色 */
.shop-card .shop-cover[src=""] {
  display: none;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(78, 205, 196, 0.4);
  z-index: 100;
}
.fab-icon {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
}

.bottom-spacer { height: 40rpx; }
