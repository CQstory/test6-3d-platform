page { background: #0f0c29; }
.login-page { min-height: 100vh; position: relative; }
.login-bg { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%); }
.login-top { position: relative; z-index: 2; padding: 120rpx 48rpx 40rpx; }
.back-btn { margin-bottom: 24rpx; }
.back-icon { font-size: 44rpx; color: rgba(255,255,255,0.7); }
.logo-area { text-align: center; }
.logo-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.logo-title { font-size: 40rpx; font-weight: 700; color: #fff; }
.logo-sub { font-size: 24rpx; color: rgba(255,255,255,0.5); margin-top: 8rpx; }
.login-card { position: relative; z-index: 2; margin: 0 48rpx; padding: 48rpx 40rpx; background: rgba(255,255,255,0.08); border-radius: 24rpx; backdrop-filter: blur(20px); border: 1rpx solid rgba(255,255,255,0.1); }
.card-title { display: block; text-align: center; font-size: 34rpx; font-weight: 600; color: #fff; margin-bottom: 36rpx; }
.input-group { margin-bottom: 24rpx; }
.input-label { font-size: 26rpx; color: rgba(255,255,255,0.6); display: block; margin-bottom: 8rpx; }
.form-input { width: 100%; padding: 22rpx 28rpx; box-sizing: border-box; background: rgba(255,255,255,0.12); border-radius: 16rpx; font-size: 28rpx; color: #fff; border: 1rpx solid rgba(255,255,255,0.1); }
.error-tip { margin-bottom: 16rpx; text-align: center; }
.error-tip text { font-size: 24rpx; color: #ff6b6b; }
.btn-login { width: 100%; margin-top: 8rpx; height: 90rpx; line-height: 90rpx; background: linear-gradient(135deg, #f5759f, #e8557d); color: #fff; border-radius: 50rpx; font-size: 32rpx; font-weight: 600; }
.btn-login::after { border: none; }
.btn-login[disabled] { opacity: 0.4; }
.aux-links { display: flex; justify-content: center; align-items: center; margin-top: 24rpx; }
.aux-links text { font-size: 26rpx; color: rgba(255,255,255,0.5); }
