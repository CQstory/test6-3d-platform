<view class="login-page">
  <view class="login-bg"></view>
  <view class="login-top">
    <view class="back-btn" bindtap="onGoBack">
      <text class="back-icon">←</text>
    </view>
    <view class="logo-area">
      <view class="logo-icon">🧊</view>
      <view class="logo-title">创建账号</view>
      <view class="logo-sub">加入3D模型社区</view>
    </view>
  </view>

  <view class="login-card">
    <text class="card-title">手机号注册</text>

    <view class="input-group">
      <text class="input-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号"
             maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="input-group">
      <text class="input-label">密码（至少6位）</text>
      <input class="form-input" placeholder="请设置密码" password="{{true}}"
             value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <view class="input-group">
      <text class="input-label">确认密码</text>
      <input class="form-input" placeholder="请再次输入密码" password="{{true}}"
             value="{{confirmPassword}}" bindinput="onConfirmPwdInput" />
    </view>
    <view class="error-tip" wx:if="{{errorMsg}}">
      <text>{{errorMsg}}</text>
    </view>

    <button class="btn-login" bindtap="onRegister"
            disabled="{{!phone || password.length < 6 || !confirmPassword || isSubmitting}}"
            loading="{{isSubmitting}}">注 册</button>

    <view class="aux-links" style="justify-content:center;">
      <text bindtap="onGoLogin">已有账号？去登录</text>
    </view>
  </view>
</view>
