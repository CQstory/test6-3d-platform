page { background: #f5f5f5; }
.profile-page { min-height: 100vh; padding-bottom: 120rpx; }

/* 深色背景（位置不动，内容下移与头像齐平） */
.hero-bg {
  background: linear-gradient(135deg, #1a1a2e 0%, #302b63 100%);
  padding: 132rpx 40rpx 40rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.hero-row {
  display: flex;
  align-items: center;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.15);
  flex-shrink: 0;
}
.hero-info {
  margin-left: 24rpx;
  flex: 1;
  overflow: hidden;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.role-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #4ecdc4;
  background: rgba(78, 205, 196, 0.18);
  border: 1rpx solid rgba(78, 205, 196, 0.5);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.sub-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  display: block;
  margin-top: 12rpx;
}

/* 登录/注册按钮：白色背景（深色背景之外） */
.login-bar {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.btn-primary {
  flex: 1;
  padding: 20rpx 0;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-primary::after { border: none; }
.btn-ghost {
  flex: 1;
  padding: 20rpx 0;
  background: #fff;
  color: #4ecdc4;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: 2rpx solid #4ecdc4;
}
.btn-ghost::after { border: none; }

/* 菜单分组 */
.menu-group {
  margin: 24rpx 24rpx 0;
}
.group-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
  padding: 0 8rpx 16rpx;
}
.menu-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 34rpx; margin-right: 20rpx; }
.menu-label { flex: 1; font-size: 28rpx; color: #333; }
.menu-arrow { font-size: 36rpx; color: #ccc; }
.logout-label { color: #e74c3c; }
