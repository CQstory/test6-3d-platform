page { background: #0f0c29; }
.profile-page { min-height: 100vh; position: relative; padding-top: 100rpx; padding-bottom: 120rpx; }
.profile-bg { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%); }

/* === 用户卡片 === */
.user-card {
  position: relative; z-index: 2;
  margin: 0 40rpx; padding: 48rpx 32rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
  text-align: center;
}
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.1); }
.nickname { font-size: 36rpx; font-weight: 700; color: #fff; display: block; margin-top: 20rpx; }
.sub-text { font-size: 24rpx; color: rgba(255,255,255,0.45); display: block; margin-top: 8rpx; }
.login-btns { display: flex; gap: 16rpx; justify-content: center; margin-top: 24rpx; }
.btn-primary { padding: 18rpx 56rpx; background: linear-gradient(135deg, #f5759f, #e8557d); color: #fff; border-radius: 40rpx; font-size: 28rpx; }
.btn-primary::after { border: none; }
.btn-ghost { padding: 18rpx 56rpx; background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.7); border-radius: 40rpx; font-size: 28rpx; border: 1rpx solid rgba(255,255,255,0.15); }
.btn-ghost::after { border: none; }

/* === 菜单列表 === */
.menu-list { position: relative; z-index: 2; margin: 24rpx 40rpx; background: rgba(255,255,255,0.06); border-radius: 24rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,0.08); }
.menu-item { display: flex; align-items: center; padding: 32rpx 28rpx; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-label { flex: 1; font-size: 28rpx; color: rgba(255,255,255,0.85); }
.menu-arrow { font-size: 36rpx; color: rgba(255,255,255,0.25); }
.logout-item { border-top: 1rpx solid rgba(255,255,255,0.06); }
.logout-label { color: rgba(255,100,100,0.8); }
