page {
  background: #f5f5f5;
}

.home-page {
  min-height: 100vh;
}

.page-content {
  padding-bottom: 120rpx;
}

/* Banner */
.banner-section {
  padding: 24rpx 24rpx;
}

.banner-swiper {
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.5));
}

.banner-content {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
}

.banner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 6rpx;
}

.banner-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* Section */
.section {
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 24rpx;
  color: #999999;
}

/* Hot List */
.hot-list {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-image-wrapper {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.hot-image {
  width: 100%;
  height: 100%;
}

.hot-rank {
  position: absolute;
  top: 0;
  left: 0;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  border-radius: 0 0 10rpx 0;
}

.rank-num {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
}

.hot-info {
  flex: 1;
  padding-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.hot-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
}

.hot-merchant {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.hot-stats {
  display: flex;
  gap: 20rpx;
}

.hot-stat {
  font-size: 22rpx;
  color: #999999;
}

/* Expand Button */
.expand-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx;
  margin-top: 8rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.expand-text {
  font-size: 26rpx;
  color: #666666;
}

.expand-icon {
  font-size: 18rpx;
  color: #999999;
}

/* Featured scroll */
.featured-scroll {
  width: 100%;
  white-space: nowrap;
}

.featured-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.featured-item {
  display: inline-block;
  width: 300rpx;
}

/* CTA Banner */
.cta-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
  border-radius: 16rpx;
}

.cta-text {
  flex: 1;
}

.cta-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 6rpx;
}

.cta-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.4;
  display: block;
}

.cta-arrow {
  font-size: 40rpx;
  color: #ffffff;
  opacity: 0.8;
}

.bottom-spacer {
  height: 20rpx;
}
