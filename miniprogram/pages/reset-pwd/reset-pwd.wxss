page { background: #f5f5f5; }
.page { min-height: 100vh; }
.page-content { padding-left: 48rpx; padding-right: 48rpx; }
.form-card { background: #fff; border-radius: 16rpx; padding: 40rpx 32rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.form-title { font-size: 36rpx; font-weight: 600; color: #1a1a1a; display: block; margin-bottom: 32rpx; text-align: center; }
.input-group { margin-bottom: 24rpx; }
.input-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 8rpx; }
.form-input {
  width: 100%; padding: 20rpx 24rpx;
  background: #f5f5f5; border-radius: 12rpx;
  font-size: 28rpx; color: #333; box-sizing: border-box;
}
.error-tip { margin-bottom: 16rpx; text-align: center; }
.error-tip text { font-size: 24rpx; color: #ff6b6b; }
.btn-submit {
  width: 100%; margin-top: 16rpx; padding: 24rpx;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #fff; border-radius: 12rpx; font-size: 32rpx; font-weight: 500;
}
.form-links { display: flex; justify-content: center; gap: 32rpx; margin-top: 24rpx; }
.form-links text { font-size: 26rpx; color: #4ecdc4; }
.msg-tip { margin-bottom: 16rpx; text-align: center; }
.msg-tip text { font-size: 24rpx; color: #4ecdc4; }
